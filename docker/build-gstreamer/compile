#!/bin/bash
set -e

source $HOME/.cargo/env

# Build LD_PRELOAD shim that replaces glibc's deprecated mallinfo() with a
# stub returning a zeroed struct. Works around a Chromium bug where
# MemoryInfra crashes with SIGILL once heap addresses exceed 2 GiB, because
# mallinfo()'s int fields overflow. Install both into the live filesystem and
# into /compiled-binaries so it propagates to dev/prod images via COPY --from=0.
# @see https://github.com/chromiumembedded/cef/issues/3963
gcc -O2 -Wall -Wextra -fPIC -shared -o /usr/lib/libfakemallinfo.so /fake_mallinfo.c
mkdir -p /compiled-binaries/usr/lib
cp /usr/lib/libfakemallinfo.so /compiled-binaries/usr/lib/libfakemallinfo.so

export CC=`which clang`
export CXX=`which clang++`

pushd gstreamer
# `-Dlibnice:gupnp=disabled` is for libnice, because libgupnp-igd causes memory leaks.
MESON_OPTIONS="-Dgpl=enabled -Dgst-examples=disabled -Dexamples=disabled -Dtests=disabled -Ddoc=disabled -Dqt5=disabled -Dpython=disabled -Dges=disabled -Ddevtools=disabled -Dintrospection=disabled -Dlibnice:gupnp=disabled"

if [[ $DEBUG == 'true' ]]; then
  if [[ $OPTIMIZATIONS == 'true' ]]; then
    meson setup build --prefix=/usr --buildtype=debugoptimized $MESON_OPTIONS
  else
    meson setup build --prefix=/usr --buildtype=debug $MESON_OPTIONS
  fi
else
  meson setup build --prefix=/usr --buildtype=release -Db_lto=true $MESON_OPTIONS
fi

git apply /compile-patch/gstreamer/0001-compositor-add-rounded-corners-property-for-sink-pad.patch
git apply /compile-patch/gstreamer/0002-compositor-add-box-shadow-property-for-sink-pads.patch
git apply /compile-patch/gstreamer/0003-Reduce-logs-verbosity-in-webrtcbin-when-a-FEC-decode.patch
git apply /compile-patch/gstreamer/0004-souphttpsrc-fix-race-conditions-when-looping.patch

# This is needed for other plugins to be built properly
ninja -C build install
# This is where we'll grab build artifacts from
DESTDIR=/compiled-binaries ninja -C build install
popd

# Build the GStreamer CEF plugin
pushd gstcefsrc
git apply /compile-patch/cefsrc/0001-cefsrc-download-minimal-package.patch
git apply /compile-patch/cefsrc/0002-cefsrc-unmultiply-alpha.patch
git apply /compile-patch/cefsrc/0003-Remove-downloads-SHA1-verification.patch

source /.cef-config.sh
cmake -S. -Bbuild -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/cef -GNinja -DCEF_BUILDS_HOMEPAGE_URL=$CEF_BUILDS_HOMEPAGE_URL -DCEF_VERSION=$CEF_VERSION -DCEF_MINIMAL_PACKAGE=ON

DESTDIR=/compiled-binaries ninja -C build install
rm -fr build third_party
popd

pushd /compiled-binaries/usr/cef
strip -s ./*.so
strip -s ./libvulkan.so.1
strip -s ./gstcefsubprocess
strip -s ./chrome-sandbox

chown root:root ./chrome-sandbox
chmod 4755 ./chrome-sandbox
popd

gst-inspect-1.0
