From 2494f52e5863405370d26d5958aed8ddf08c6145 Mon Sep 17 00:00:00 2001
From: Mykhailo Chelnokov <mchelnokov@gmail.com>
Date: Mon, 17 Aug 2026 12:53:01 +0300
Subject: [PATCH 1/3] rtmp2/rtmpclient: Close the connection when the connect
 task fails

A GstRtmpConnection's input GSource holds a strong reference back to
the connection, and the connection references the GMainContext the
source is attached to. This cycle is only broken by
gst_rtmp_connection_close (), which destroys the input source; a
connection that is unreffed without being closed lives forever,
keeping its socket and the eventfd of its cancellable open.

The connect task released its connection with g_clear_object () only.
Every failure after handshake completion - the server rejecting the
'connect' command, authentication failures, a missing secureToken, a
write error during the command exchange - unreffed the connection
without closing it and leaked two file descriptors. A client retrying
against such a server accumulates them until the process hits EMFILE.

Hand the reference over to the caller with g_steal_pointer () on
success, and make connect_task_data_free () close whatever connection
it still owns. This matches socket_connect (), which already closes
the previous connection explicitly on the authmod retry path.

The cancellation flavour of this leak was reported in
https://gitlab.freedesktop.org/gstreamer/gst-plugins-bad/-/issues/1425
and fixed by 1f7515100caf06fb31d84a40be49dcefd176fce3 ("rtmp2/connection:
pass the parent cancellable down to the connection"); the rejection
flavour described in the same report was not covered by that fix.
---
 .../gst-plugins-bad/gst/rtmp2/rtmp/rtmpclient.c       | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/subprojects/gst-plugins-bad/gst/rtmp2/rtmp/rtmpclient.c b/subprojects/gst-plugins-bad/gst/rtmp2/rtmp/rtmpclient.c
index d61e407..556d25e 100644
--- a/subprojects/gst-plugins-bad/gst/rtmp2/rtmp/rtmpclient.c
+++ b/subprojects/gst-plugins-bad/gst/rtmp2/rtmp/rtmpclient.c
@@ -368,7 +368,12 @@ connect_task_data_free (gpointer ptr)
   if (data->error_handler_id) {
     g_signal_handler_disconnect (data->connection, data->error_handler_id);
   }
-  g_clear_object (&data->connection);
+  /* On success the connection is stolen by send_secure_token_response ();
+   * a connection still owned here means the task failed and nobody else is
+   * going to close it. Closing is what destroys the connection's input
+   * GSource, which holds a reference back to the connection - without it
+   * the connection, its socket and its cancellable's eventfd are leaked. */
+  g_clear_pointer (&data->connection, gst_rtmp_connection_close_and_unref);
   g_free (data);
 }
 
@@ -1319,7 +1324,9 @@ send_secure_token_response (GTask * task, GstRtmpConnection * connection,
   g_signal_handler_disconnect (connection, data->error_handler_id);
   data->error_handler_id = 0;
 
-  g_task_return_pointer (task, g_object_ref (connection),
+  /* Transfer data->connection to the caller; connect_task_data_free ()
+   * closes any connection the task still owns. */
+  g_task_return_pointer (task, g_steal_pointer (&data->connection),
       gst_rtmp_connection_close_and_unref);
   g_object_unref (task);
 }
