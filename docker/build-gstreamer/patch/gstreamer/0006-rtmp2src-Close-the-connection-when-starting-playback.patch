From be2c04503e5d57e4688f07dc18eaa3fa4dd8ef06 Mon Sep 17 00:00:00 2001
From: Mykhailo Chelnokov <mchelnokov@gmail.com>
Date: Mon, 17 Aug 2026 12:53:02 +0300
Subject: [PATCH 2/3] rtmp2src: Close the connection when starting playback
 fails

client_connect_done () stores the freshly established connection as
task data with plain g_object_unref () as the destroy notify. But a
GstRtmpConnection must be closed to be freed: its input GSource holds
a reference back to the connection, and only
gst_rtmp_connection_close () destroys that source.

When createStream or play is rejected by the server (for example
NetStream.Play.StreamNotFound from a stream that is not being
published), the connection was unreffed without ever being closed and
leaked together with its TCP socket and the eventfd of its
cancellable. An element retrying an unpublished stream leaks two file
descriptors per attempt; a long-running process eventually runs out.
Observed in production as hundreds of stranded connections (sockets
stuck in CLOSE_WAIT) in a process polling a relay every 10 seconds.

Also close the connection on the cancelled paths. Today those are
usually rescued because cancellation wakes the input source, which
then removes itself before the element's loop quits, but that relies
on dispatch ordering rather than on ownership.

The success path is unchanged: it hands a new reference to the element
with gst_rtmp_connection_close_and_unref as the destroy notify.
---
 subprojects/gst-plugins-bad/gst/rtmp2/gstrtmp2src.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/subprojects/gst-plugins-bad/gst/rtmp2/gstrtmp2src.c b/subprojects/gst-plugins-bad/gst/rtmp2/gstrtmp2src.c
index a997675..ca50434 100644
--- a/subprojects/gst-plugins-bad/gst/rtmp2/gstrtmp2src.c
+++ b/subprojects/gst-plugins-bad/gst/rtmp2/gstrtmp2src.c
@@ -895,6 +895,11 @@ client_connect_done (GObject * source, GAsyncResult * result,
   g_task_set_task_data (task, connection, g_object_unref);
 
   if (g_task_return_error_if_cancelled (task)) {
+    /* The task data notify only unrefs the connection; it has to be closed
+     * to destroy its input GSource, which holds a reference back to the
+     * connection. An unclosed connection therefore outlives the unref,
+     * leaking itself, its socket and its cancellable's eventfd. */
+    gst_rtmp_connection_close (connection);
     g_object_unref (task);
     return;
   }
@@ -914,6 +919,7 @@ start_play_done (GObject * source, GAsyncResult * result, gpointer user_data)
   GError *error = NULL;
 
   if (g_task_return_error_if_cancelled (task)) {
+    gst_rtmp_connection_close (connection);
     g_object_unref (task);
     return;
   }
@@ -923,6 +929,9 @@ start_play_done (GObject * source, GAsyncResult * result, gpointer user_data)
     g_task_return_pointer (task, g_object_ref (connection),
         gst_rtmp_connection_close_and_unref);
   } else {
+    /* The rejected connection is handed over to nobody; close it so it is
+     * actually freed together with its socket. */
+    gst_rtmp_connection_close (connection);
     g_task_return_error (task, error);
   }
 
