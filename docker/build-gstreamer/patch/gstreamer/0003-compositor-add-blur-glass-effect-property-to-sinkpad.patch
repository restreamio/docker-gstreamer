@@ -2428,6 +2491,102 @@ has_visible_src_rect (GstVideoRectangle * visible_src_rect_out,
   return (visible_src_rect_out->w > 0 && visible_src_rect_out->h > 0);
 }
 
+static gboolean
+format_supports_blur_glass (GstVideoFormat format)
+{
+  switch (format) {
+    case GST_VIDEO_FORMAT_ARGB:
+    case GST_VIDEO_FORMAT_BGRA:
+    case GST_VIDEO_FORMAT_ABGR:
+    case GST_VIDEO_FORMAT_RGBA:
+    case GST_VIDEO_FORMAT_xRGB:
+    case GST_VIDEO_FORMAT_xBGR:
+    case GST_VIDEO_FORMAT_RGBx:
+    case GST_VIDEO_FORMAT_BGRx:
+      return TRUE;
+    default:
+      return FALSE;
+  }
+}
+
+static gboolean
+is_dropped_by_rounded_corner (guint local_x, guint local_y,
+    const GstVideoRectangle * dest_rect, const guint * border_radius)
+{
+  for (gint c = 0; c < 4; ++c) {
+    guint radius = border_radius[c];
+    if (radius == 0) {
+      continue;
+    }
+
+    float dist = compute_rounded_corner_square_dist (local_x, local_y,
+        dest_rect->w, dest_rect->h, radius, c);
+
+    if (dist >= (float) radius * radius) {
+      return TRUE;
+    }
+  }
+
+  return FALSE;
+}
+
+static void
+blur_glass_background (CompositeTask * comp,
+    const GstVideoRectangle * visible_rect,
+    const GstVideoRectangle * dest_rect, const guint * border_radius,
+    guint radius)
+{
+  GstVideoFrame *out_frame = comp->out_frame;
+
+  if (!format_supports_blur_glass (GST_VIDEO_FRAME_FORMAT (out_frame))) {
+    return;
+  }
+
+  guint8 *image_data = GST_VIDEO_FRAME_PLANE_DATA (out_frame, 0);
+  guint line_stride = GST_VIDEO_FRAME_PLANE_STRIDE (out_frame, 0);
+  gint frame_width = GST_VIDEO_FRAME_WIDTH (out_frame);
+  guint32 *row_copy = g_new (guint32, frame_width);
+
+  guint last_visible_line = visible_rect->y + visible_rect->h - 1;
+  guint last_visible_col = visible_rect->x + visible_rect->w - 1;
+
+  for (guint y = visible_rect->y; y <= last_visible_line; ++y) {
+    guint32 *line = (guint32 *) (image_data + y * line_stride);
+    memcpy (row_copy, line, frame_width * sizeof (guint32));
+    guint local_y = (guint) ((gint) y - dest_rect->y);
+
+    for (guint x = visible_rect->x; x <= last_visible_col; ++x) {
+      guint local_x = (guint) ((gint) x - dest_rect->x);
+
+      if (is_dropped_by_rounded_corner (local_x, local_y, dest_rect,
+              border_radius)) {
+        continue;
+      }
+
+      gint start = MAX (0, (gint) x - (gint) radius);
+      gint end = MIN (frame_width - 1, (gint) x + (gint) radius);
+      guint count = end - start + 1;
+      guint sum[4] = { 0, 0, 0, 0 };
+
+      for (gint i = start; i <= end; ++i) {
+        guint8 *pixel = (guint8 *) (row_copy + i);
+        sum[0] += pixel[0];
+        sum[1] += pixel[1];
+        sum[2] += pixel[2];
+        sum[3] += pixel[3];
+      }
+
+      guint8 *dst_pixel = (guint8 *) (line + x);
+      dst_pixel[0] = sum[0] / count;
+      dst_pixel[1] = sum[1] / count;
+      dst_pixel[2] = sum[2] / count;
+      dst_pixel[3] = sum[3] / count;
+    }
+  }
+
+  g_free (row_copy);
+}
+
 static void
 blend_pads (CompositeTask * comp)
 {
@@ -2457,6 +2616,15 @@ blend_pads (CompositeTask * comp)
             info->prepared_frame);
       }
     }
+    // Blur the composited background behind this pad (frosted-glass effect)
+    if (info->blur_glass && info->blur_glass_radius > 0 && info->has_alpha) {
+      if (has_visible_src_rect (&visible_src_rect, &dest_rect, comp)) {
+        visible_src_rect.x += dest_rect.x;
+        visible_src_rect.y += dest_rect.y;
+        blur_glass_background (comp, &visible_src_rect, &dest_rect,
+            info->border_radius, info->blur_glass_radius);
+      }
+    }
     // Compute and compose the box shadows
     for (guint j = 0; j < info->box_shadows_len; ++j) {
       BoxShadowFrame *shadow = info->box_shadows + j;
