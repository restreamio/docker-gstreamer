  *   - "blur" the shadow blur-radius value as a #guint
  *   - "spread" the shadow spread-radius value as a #gint
  *   - "color" the shadow color value as a #guint32 in ARGB order
+ * * "blur-glass": Whether to apply a blur-glass effect to the picture
+ *   (#gboolean) allowing to show a box-blurred version of the background behind
+ *   the picture. The effect is disable if the picture is opaque (alpha=1.0 and
+ *   no alpha channel in the input video format) or if the "blur-glass-radius"
+ *   property is set to 0.
+ * * "blur-glass-radius": The radius in pixels of the blur-glass effect
+ *   (#guint). The effect is disable if set to 0.
  *
  * ## Sample pipelines
  * |[
@@ -258,6 +265,8 @@ gst_compositor_sizing_policy_get_type (void)
 #define DEFAULT_PAD_OPERATOR COMPOSITOR_OPERATOR_OVER
 #define DEFAULT_PAD_SIZING_POLICY COMPOSITOR_SIZING_POLICY_NONE
 #define DEFAULT_PAD_BORDER_RADIUS 0
+#define DEFAULT_PAD_BLUR_GLASS FALSE
+#define DEFAULT_PAD_BLUR_GLASS_RADIUS 10
 
