       break;
@@ -1116,6 +1139,35 @@ gst_compositor_pad_class_init (GstCompositorPadClass * klass)
               G_PARAM_STATIC_STRINGS),
           G_PARAM_READWRITE | GST_PARAM_CONTROLLABLE | G_PARAM_STATIC_STRINGS));
 
+  /**
+   * GstCompositorPad:blur-glass:
+   *
+   * If %TRUE, blurs the region of the output frame already composited
+   * behind this pad's picture (frosted-glass effect) before drawing it.
+   * Only applied when the negotiated output format is one of the 8-bit
+   * packed RGB formats (ARGB, BGRA, ABGR, RGBA, xRGB, xBGR, RGBx, BGRx).
+   *
+   * Since: 1.30
+   */
+  g_object_class_install_property (gobject_class, PROP_PAD_BLUR_GLASS,
+      g_param_spec_boolean ("blur-glass", "Blur Glass",
+          "Blur the composited background behind this pad's picture",
+          DEFAULT_PAD_BLUR_GLASS,
+          G_PARAM_READWRITE | GST_PARAM_CONTROLLABLE | G_PARAM_STATIC_STRINGS));
+
+  /**
+   * GstCompositorPad:blur-glass-radius:
+   *
+   * The box blur radius, in pixels, used by the "blur-glass" effect.
+   *
+   * Since: 1.30
+   */
+  g_object_class_install_property (gobject_class, PROP_PAD_BLUR_GLASS_RADIUS,
+      g_param_spec_uint ("blur-glass-radius", "Blur Glass Radius",
+          "Box blur radius in pixels used by the \"blur-glass\" effect",
+          0, G_MAXUINT, DEFAULT_PAD_BLUR_GLASS_RADIUS,
+          G_PARAM_READWRITE | GST_PARAM_CONTROLLABLE | G_PARAM_STATIC_STRINGS));
+
   vaggpadclass->prepare_frame_start =
       GST_DEBUG_FUNCPTR (gst_compositor_pad_prepare_frame_start);
 
